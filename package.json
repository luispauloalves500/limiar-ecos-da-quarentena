{
  "name": "limiar-ecos-da-quarentena",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Fatia vertical original de terror e sobrevivência em câmeras fixas",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src tests scripts",
    "preview": "vite preview --host 0.0.0.0",
    "smoke": "node scripts/smoke.mjs",
    "format": "prettier --write src tests scripts *.json *.ts *.js *.html .github/workflows/*.yml",
    "smoke:published": "node scripts/published-smoke.mjs",
    "smoke:zombie": "node scripts/zombie-smoke.mjs",
    "smoke:player": "node scripts/player-smoke.mjs",
    "verify:published": "node scripts/verify-published.mjs",
    "smoke:environment": "node scripts/environment-smoke.mjs"
  },
  "dependencies": {
    "three": "^0.187.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@types/three": "^0.187.0",
    "eslint": "^10.14.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "overrides": {
    "minimatch": "^11.0.1"
  }
}
